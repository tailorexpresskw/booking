# Server-only payment settings. Do not put real secrets in Flutter web code.
# Sandbox testing: keep sandbox URL. Live payments: use https://uapi.upayments.com and your live plain API token.
UPAYMENTS_API_KEY=replace_with_live_upayments_bearer_token
UPAYMENTS_SANDBOX_API_KEY=replace_with_optional_sandbox_token
UPAYMENTS_BASE_URL=https://sandboxapi.upayments.com
PAYMENT_AMOUNT_KWD=3.500
APP_BASE_URL=http://127.0.0.1:8090
PORT=8090
